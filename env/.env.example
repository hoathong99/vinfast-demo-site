# Copy this file to `env/.env` and fill the values.
#
# Cloudflare Worker endpoint, for example:
# https://vinfast-lead-api.your-subdomain.workers.dev/lead
PUBLIC_API_ENDPOINT=

# Optional: separate event endpoint. If empty, the site uses PUBLIC_API_ENDPOINT.
PUBLIC_EVENT_ENDPOINT=

# Used to pre-fill the setup helpers on /cau-hinh/ (not secrets).
PUBLIC_WORKER_NAME=vinfast-lead-api
PUBLIC_WORKERS_SUBDOMAIN=
PUBLIC_PRODUCTION_ORIGIN=https://yourname.github.io

# Optional Apps Script fallback. Not used with the Cloudflare Worker backend.
PUBLIC_SHEET_ENDPOINT=
