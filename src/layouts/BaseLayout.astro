---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ZaloBubble from "../components/ZaloBubble.astro";
import StickyCTA from "../components/StickyCTA.astro";
import BackTop from "../components/BackTop.astro";
import { site } from "../data/site";
import { url } from "../lib/format";
import fontVi from "../assets/fonts/mulish-vietnamese.woff2?url";
import fontLatin from "../assets/fonts/mulish-latin.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  image = "/images/hero-1.webp",
  noindex = true,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = new URL(url(image), Astro.site ?? Astro.url).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  telephone: site.hotlineSales,
  email: site.email,
  url: canonical,
  image: ogImage,
  address: {
    "@type": "PostalAddress",
    streetAddress: "123 Đường Demo",
    addressLocality: "Hà Nội",
    addressCountry: "VN",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:00",
      closes: "17:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "08:00",
      closes: "17:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Sunday",
      opens: "08:00",
      closes: "12:00",
    },
  ],
  sameAs: [site.zaloUrl],
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; img-src 'self' data:; script-src 'self' https://script.google.com https://script.googleusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; frame-src https://www.google.com https://maps.google.com; upgrade-insecure-requests"
    />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url("images/favicon.png")} />
    <link rel="preload" href={fontVi} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua điều hướng</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ZaloBubble />
    <StickyCTA />
    <BackTop />
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
