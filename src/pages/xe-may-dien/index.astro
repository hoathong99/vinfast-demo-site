---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VehicleListing from "../../components/VehicleListing.astro";
import { motorbikes } from "../../data/vehicles";
---

<BaseLayout
  title="Xe máy điện — VinFast Demo"
  description="Danh sách xe máy điện demo: Evo, Viper với thông số và giá minh họa."
>
  <VehicleListing
    title="Xe máy điện"
    eyebrow="Xe máy điện"
    description="Hai mẫu xe máy điện demo. Giá và thông số chỉ dùng để kiểm tra giao diện, không phải báo giá chính thức."
    vehicles={motorbikes}
    types={[
      { label: "Xe phổ thông", value: "pho-thong" },
      { label: "Xe thể thao", value: "the-thao" },
    ]}
    priceRange={{ min: 15_000_000, max: 50_000_000, step: 1_000_000 }}
    contactTitle="Nhận báo giá xe máy điện"
  />
</BaseLayout>
