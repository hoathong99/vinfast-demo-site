---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VehicleListing from "../../components/VehicleListing.astro";
import { cars } from "../../data/vehicles";
---

<BaseLayout
  title="Ô tô điện — VinFast Demo"
  description="Danh sách ô tô điện demo: VF 3, VF 5, VF 8, VF 9 với thông số và giá minh họa."
>
  <VehicleListing
    title="Ô tô điện"
    eyebrow="Ô tô điện"
    description="Bốn mẫu ô tô điện demo. Giá và thông số chỉ dùng để kiểm tra giao diện, không phải báo giá chính thức."
    vehicles={cars}
    types={[
      { label: "Mini SUV", value: "mini-suv" },
      { label: "SUV", value: "suv" },
    ]}
    priceRange={{ min: 200_000_000, max: 1_500_000_000, step: 10_000_000 }}
    contactTitle="Nhận báo giá ô tô điện"
  />
</BaseLayout>
