---
import BaseLayout from "../layouts/BaseLayout.astro";
import TestDriveForm from "../components/TestDriveForm.astro";
import { url } from "../lib/format";
---

<BaseLayout
  title="Đăng ký lái thử — VinFast Demo"
  description="Đăng ký lái thử ô tô điện hoặc xe máy điện tại showroom demo."
>
  <section class="booking-head">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={url("")}>Trang chủ</a>
        <span>/</span>
        <span aria-current="page">Đăng ký lái thử</span>
      </nav>
      <h1>Đăng ký lái thử</h1>
      <p>Để đăng ký lái thử, Quý khách cần cung cấp giấy phép lái xe cho VinFast.</p>
    </div>
  </section>

  <section class="booking-section">
    <div class="container">
      <TestDriveForm />
      <p class="booking-note">
        <span data-sheet-status>Đang kiểm tra cấu hình lưu dữ liệu…</span>
        <a href={url("cau-hinh/")}>Cấu hình Google Sheet →</a>
      </p>
    </div>
  </section>
</BaseLayout>
