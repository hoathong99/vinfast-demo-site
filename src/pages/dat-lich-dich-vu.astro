---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceBookingForm from "../components/ServiceBookingForm.astro";
import { url } from "../lib/format";

const services = [
  { id: "bao-duong", title: "Bảo dưỡng định kỳ", text: "Kiểm tra tổng quát, thay dầu, kiểm tra pin và hệ thống điện." },
  { id: "sua-chua", title: "Sửa chữa chung", text: "Chẩn đoán lỗi, sửa chữa hệ thống điện, gầm và thân vỏ." },
  { id: "dong-son", title: "Đồng sơn", text: "Sửa chữa va chạm nhẹ, sơn lại chi tiết theo màu xe." },
  { id: "kiem-tra-pin", title: "Kiểm tra pin", text: "Đánh giá tình trạng pin và tư vấn phương án sử dụng." },
];
---

<BaseLayout
  title="Đặt lịch dịch vụ — VinFast Demo"
  description="Đặt lịch bảo dưỡng, sửa chữa xe điện tại xưởng dịch vụ demo."
>
  <section class="booking-head">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={url("")}>Trang chủ</a>
        <span>/</span>
        <span aria-current="page">Đặt lịch dịch vụ</span>
      </nav>
      <h1>Đặt lịch dịch vụ</h1>
      <p>Đặt hẹn bảo dưỡng hoặc sửa chữa để giảm thời gian chờ tại xưởng demo.</p>
    </div>
  </section>

  <section class="service-strip">
    <div class="container">
      <div class="news-grid">
        {services.map((service) => (
          <article class="highlight-item" id={service.id}>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="booking-section">
    <div class="container">
      <ServiceBookingForm />
    </div>
  </section>
</BaseLayout>
