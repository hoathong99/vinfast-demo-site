---
import VehicleCard from "../components/VehicleCard.astro";
import LeadForm from "../components/LeadForm.astro";
import type { Vehicle } from "../data/vehicles";
import { formatVnd, url } from "../lib/format";

interface FilterOption {
  label: string;
  value: string;
}

interface PriceRange {
  min: number;
  max: number;
  step: number;
}

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  vehicles: Vehicle[];
  types?: FilterOption[];
  priceRange?: PriceRange;
  contactTitle?: string;
}

const {
  title,
  eyebrow,
  description,
  vehicles,
  types = [],
  priceRange,
  contactTitle = "Nhận báo giá",
} = Astro.props;

const compactPrice = (value: number): string => {
  if (value >= 1_000_000_000) {
    return `${new Intl.NumberFormat("vi-VN", { maximumFractionDigits: 1 }).format(value / 1_000_000_000)} tỷ`;
  }
  return `${new Intl.NumberFormat("vi-VN").format(value / 1_000_000)} triệu`;
};
---

<div class="page-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={url("")}>Trang chủ</a>
      <span>/</span>
      <span aria-current="page">{eyebrow}</span>
    </nav>
    <div class="eyebrow">{eyebrow}</div>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</div>

<section class="section">
  <div class="container">
    {(types.length > 0 || priceRange) && (
      <div
        class="filter-panel"
        data-filter-panel
        data-price-min={priceRange?.min}
        data-price-max={priceRange?.max}
        data-price-step={priceRange?.step}
      >
        <div class="filter-row">
          {types.length > 0 && (
            <div class="filter-block filter-block--types">
              <span class="filter-label" id="filter-type-label">Loại xe</span>
              <div class="filter-options" role="group" aria-labelledby="filter-type-label" data-filter-types>
                <button class="filter-chip" type="button" data-filter-type="" aria-pressed="true">
                  Tất cả
                </button>
                {types.map((item) => (
                  <button class="filter-chip" type="button" data-filter-type={item.value} aria-pressed="false">
                    {item.label}
                  </button>
                ))}
              </div>
            </div>
          )}

          {priceRange && (
            <div class="filter-price-cluster">
              {types.length > 0 && <span class="filter-divider" aria-hidden="true"></span>}
              <div class="filter-block filter-block--price">
                <button
                  class="filter-price-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls="filter-price-body"
                  data-price-toggle
                >
                  <span class="filter-label">Giá xe</span>
                  <svg class="filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m6 15 6-6 6 6" />
                  </svg>
                </button>

                <div class="filter-price-body" id="filter-price-body" data-price-body hidden>
                  <div class="price-readout" data-price-readout>
                    Từ {formatVnd(priceRange.min)} — Đến {formatVnd(priceRange.max)}
                  </div>

                  <div class="price-slider" data-price-slider>
                    <div class="price-slider-track">
                      <div class="price-slider-rail"></div>
                      <div class="price-slider-fill" data-price-fill></div>
                      <input
                        class="price-range price-range--min"
                        type="range"
                        min={priceRange.min}
                        max={priceRange.max}
                        step={priceRange.step}
                        value={priceRange.min}
                        aria-label="Giá xe thấp nhất"
                        data-price-min-input
                      />
                      <input
                        class="price-range price-range--max"
                        type="range"
                        min={priceRange.min}
                        max={priceRange.max}
                        step={priceRange.step}
                        value={priceRange.max}
                        aria-label="Giá xe cao nhất"
                        data-price-max-input
                      />
                    </div>
                    <div class="price-ticks" aria-hidden="true"></div>
                    <div class="price-scale">
                      <span>{compactPrice(priceRange.min)}</span>
                      <span>{compactPrice(priceRange.max)}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>

        <div class="filter-footer">
          <span class="filter-count" data-filter-count aria-live="polite">{vehicles.length} mẫu xe</span>
          <button class="filter-reset" type="button" data-filter-reset>Đặt lại</button>
        </div>
      </div>
    )}

    <div class="vehicle-grid" data-vehicle-grid>
      {vehicles.map((vehicle) => <VehicleCard vehicle={vehicle} />)}
    </div>
    <div class="empty-state" data-empty-state>Không có mẫu xe phù hợp với bộ lọc.</div>
  </div>
</section>

<section class="lead-section section--soft">
  <div class="container lead-layout">
    <div class="lead-copy">
      <div class="eyebrow">Tư vấn</div>
      <h2>{contactTitle}</h2>
      <p>
        Chọn mẫu xe và để lại thông tin. Đội ngũ demo sẽ liên hệ theo khung giờ bạn mong muốn.
        Đây là dữ liệu mẫu cho mục đích trình diễn.
      </p>
      <ul>
        <li>Báo giá minh họa theo mẫu xe đang chọn.</li>
        <li>Tư vấn trả góp và thời gian giao xe demo.</li>
        <li>Đăng ký lái thử tại showroom demo.</li>
      </ul>
    </div>
    <LeadForm formType="quote" />
  </div>
</section>
