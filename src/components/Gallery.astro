---
import { url } from "../lib/format";

interface Props {
  images: string[];
  name: string;
}

const { images, name } = Astro.props;
---

<div class="gallery" data-gallery>
  <div class="gallery-main">
    <img
      data-gallery-main
      src={url(images[0])}
      alt={name}
      width="1200"
      height="900"
      loading="eager"
    />
  </div>
  <div class="gallery-thumbs" role="group" aria-label={`Thư viện ảnh ${name}`}>
    {images.map((image, index) => (
      <button
        class="gallery-thumb"
        type="button"
        data-gallery-thumb
        data-src={url(image)}
        aria-label={`Xem ảnh ${index + 1} của ${name}`}
        aria-current={index === 0 ? "true" : "false"}
      >
        <img src={url(image)} alt="" width="200" height="200" loading="lazy" />
      </button>
    ))}
  </div>
</div>
