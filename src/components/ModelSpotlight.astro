---
import type { Vehicle } from "../data/vehicles";
import { formatVnd, url } from "../lib/format";

interface Props {
  vehicles: Vehicle[];
  title: string;
  eyebrow?: string;
  description?: string;
  listingHref: string;
  soft?: boolean;
  id: string;
}

const { vehicles, title, eyebrow, description, listingHref, soft = false, id } = Astro.props;
---

<section class:list={["spotlight", { "spotlight--soft": soft }]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="section-head">
      <div>
        {eyebrow && <div class="eyebrow">{eyebrow}</div>}
        <h2 id={`${id}-title`}>{title}</h2>
        {description && <p>{description}</p>}
      </div>
      <a class="link-arrow" href={url(listingHref)}>Xem tất cả</a>
    </div>

    <div class="spotlight-carousel" data-carousel data-carousel-mode="fade" data-autoplay="8000">
      <div class="spotlight-stage" data-carousel-track>
        {vehicles.map((vehicle, index) => {
          const detailHref = url(`${vehicle.type === "car" ? "o-to-dien" : "xe-may-dien"}/${vehicle.slug}/`);
          const specs = [
            ...vehicle.quickSpecs.map((spec) => ({
              label: spec.label,
              value: spec.label === "Số chỗ ngồi" ? `${spec.value} chỗ` : spec.value,
            })),
            { label: "Giá từ", value: formatVnd(vehicle.price) },
          ];
          return (
            <article
              class:list={["spotlight-slide", { "is-active": index === 0 }]}
              data-carousel-slide
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <h3 class="sr-only">{vehicle.name} — {vehicle.tagline}</h3>
              <div class="spotlight-media">
                <a
                  href={detailHref}
                  aria-label={`Xem chi tiết ${vehicle.name}`}
                  tabindex={index === 0 ? 0 : -1}
                  draggable="false"
                >
                  <img
                    src={url(vehicle.images[0])}
                    alt={vehicle.name}
                    width="1200"
                    height="675"
                    loading={index === 0 ? "eager" : "lazy"}
                    draggable="false"
                  />
                </a>
              </div>
              <div class="spotlight-content">
                <dl class="spec-strip">
                  {specs.map((spec) => (
                    <div>
                      <dt>{spec.label}</dt>
                      <dd>{spec.value}</dd>
                    </div>
                  ))}
                </dl>
                <div class="spotlight-actions">
                  <a class="btn" href={url(`dang-ky-lai-thu/?model=${vehicle.slug}`)} tabindex={index === 0 ? 0 : -1}>
                    Đăng ký lái thử
                  </a>
                  <a class="btn btn--outline" href={detailHref} tabindex={index === 0 ? 0 : -1}>
                    Xem chi tiết
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div class="carousel-controls">
        <button class="carousel-arrow" type="button" data-carousel-prev aria-label="Xe trước">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m15 5-7 7 7 7" />
          </svg>
        </button>
        <div class="carousel-dots" data-carousel-dots>
          {vehicles.map((vehicle, index) => (
            <button
              class="carousel-dot"
              type="button"
              data-carousel-dot
              aria-label={`Xem ${vehicle.name}`}
              aria-current={index === 0 ? "true" : "false"}
            />
          ))}
        </div>
        <button class="carousel-arrow" type="button" data-carousel-next aria-label="Xe sau">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 5 7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
