---
import { site } from "../data/site";
import { url } from "../lib/format";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="footer-brand" href={url("")}>
          <img src={url("images/logo.svg")} alt="" width="240" height="298" loading="lazy" />
          <span>
            <strong>{site.name}</strong>
            <span>{site.tagline}</span>
          </span>
        </a>
        <p>{site.notice}</p>
        <p>
          {site.legalName}<br />
          Số ĐKKD: {site.taxId} (demo)
        </p>
      </div>

      <div>
        <h3>Liên kết</h3>
        <ul class="footer-links">
          <li><a href={url("o-to-dien/")}>Ô tô điện</a></li>
          <li><a href={url("xe-may-dien/")}>Xe máy điện</a></li>
          <li><a href={url("dang-ky-lai-thu/")}>Đăng ký lái thử</a></li>
          <li><a href={url("dich-vu/xe-may-dien/")}>Dịch vụ xe máy điện</a></li>
          <li><a href={url("dich-vu/o-to/")}>Dịch vụ ô tô</a></li>
          <li><a href={url("dat-lich-dich-vu/")}>Đặt lịch dịch vụ</a></li>
          <li><a href={url("tin-tuc/")}>Tin tức</a></li>
          <li><a href={url("lien-he/")}>Liên hệ</a></li>
          <li><a href={url("chinh-sach/bao-mat/")}>Chính sách bảo mật</a></li>
        </ul>
      </div>

      <div>
        <h3>Showroom demo</h3>
        <ul class="footer-contact">
          <li>
            <span>Địa chỉ</span>
            <a href={site.mapUrl} target="_blank" rel="noopener noreferrer">{site.address}</a>
          </li>
          <li>
            <span>Hotline bán hàng</span>
            <a href={site.hotlineSalesHref} data-track="call_click">{site.hotlineSales}</a>
          </li>
          <li>
            <span>Hotline dịch vụ</span>
            <a href={site.hotlineServiceHref} data-track="call_click">{site.hotlineService}</a>
          </li>
          <li>
            <span>Zalo</span>
            <a href={site.zaloUrl} target="_blank" rel="noopener noreferrer" data-track="zalo_open">Chat Zalo</a>
          </li>
          <li>
            <span>Giờ mở cửa</span>
            <div class="footer-hours">
              {site.hours.map((item) => <p>{item.label}: {item.value}</p>)}
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}. Website demo, không phải website chính thức.</p>
      <p>
        Dữ liệu hình ảnh và giá chỉ dùng cho mục đích trình diễn.
        <a href={url("cau-hinh/")}>Cấu hình Google Sheet</a>
      </p>
    </div>
  </div>
</footer>
