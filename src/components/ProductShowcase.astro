---
import type { Vehicle } from "../data/vehicles";
import type { VehicleDetailContent } from "../data/vehicle-details";
import { url } from "../lib/format";

interface Props {
  vehicle: Vehicle;
  content: VehicleDetailContent;
}

const { vehicle, content } = Astro.props;
---

<section class="product-showcase section" id="thong-tin-san-pham">
  <div class="container">
    <div class="story-head story-head--center">
      <div class="eyebrow">Thông tin sản phẩm</div>
      <h2>Thông Tin Sản Phẩm</h2>
      <p>{content.infoIntro}</p>
    </div>

    <div class="product-carousel" data-carousel data-carousel-mode="fade">
      <div class="product-stage" data-carousel-track>
        {vehicle.images.map((image, index) => (
          <figure class="product-slide" data-carousel-slide aria-hidden={index === 0 ? "false" : "true"}>
            <img
              src={url(image)}
              alt={`${vehicle.name} — ảnh ${index + 1}`}
              width="1200"
              height="675"
              loading={index === 0 ? "eager" : "lazy"}
              draggable="false"
            />
          </figure>
        ))}
      </div>

      <button class="product-arrow product-arrow--prev" type="button" data-carousel-prev aria-label="Ảnh trước">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m15 5-7 7 7 7" />
        </svg>
      </button>
      <button class="product-arrow product-arrow--next" type="button" data-carousel-next aria-label="Ảnh sau">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m9 5 7 7-7 7" />
        </svg>
      </button>

      <div class="product-dots carousel-dots" data-carousel-dots>
        {vehicle.images.map((_, index) => (
          <button
            class="carousel-dot"
            type="button"
            data-carousel-dot
            aria-label={`Xem ảnh ${index + 1}`}
            aria-current={index === 0 ? "true" : "false"}
          />
        ))}
      </div>
    </div>

    <div class="product-colors" aria-label="Màu sắc minh họa">
      <span class="product-colors-label">Màu sắc</span>
      {vehicle.colors.map((color) => (
        <span class="color-swatch">
          <i style={`background:${color.hex}`}></i>
          {color.name}
        </span>
      ))}
    </div>

    <div class="story-highlights">
      {vehicle.highlights.map((highlight) => (
        <div class="story-highlight">
          <strong>{highlight.title}</strong>
          <span>{highlight.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
