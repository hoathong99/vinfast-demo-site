---
import type { Vehicle } from "../data/vehicles";
import type { VehicleDetailContent } from "../data/vehicle-details";
import { url } from "../lib/format";

interface Props {
  vehicle: Vehicle;
  content: VehicleDetailContent;
}

const { vehicle, content } = Astro.props;
---

<section class="product-showcase section" id="thong-tin-san-pham" data-product-showcase>
  <div class="container">
    <div class="story-head story-head--center">
      <div class="eyebrow">Thông tin sản phẩm</div>
      <h2>Thông Tin Sản Phẩm</h2>
      <p>{content.infoIntro}</p>
    </div>

    <div class="product-carousel" data-carousel data-carousel-mode="fade">
      <div class="product-viewport">
        <div class="product-stage" data-carousel-track>
          {vehicle.colors.map((color, index) => (
            <figure
              class="product-slide"
              data-carousel-slide
              data-color-index={index}
              data-color-name={color.name}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <img
                src={url(color.image)}
                alt={`${vehicle.name} — Màu ${color.name}`}
                width="1200"
                height="675"
                loading={index === 0 ? "eager" : "lazy"}
                draggable="false"
              />
            </figure>
          ))}
        </div>

        <button class="product-zoom" type="button" data-image-zoom aria-label={`Phóng to ảnh ${vehicle.name}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.6-3.6M8 11h6M11 8v6" />
          </svg>
        </button>
      </div>

      <button class="product-arrow product-arrow--prev" type="button" data-carousel-prev aria-label="Ảnh trước">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m15 5-7 7 7 7" />
        </svg>
      </button>
      <button class="product-arrow product-arrow--next" type="button" data-carousel-next aria-label="Ảnh sau">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m9 5 7 7-7 7" />
        </svg>
      </button>

      <div class="product-dots carousel-dots" data-carousel-dots>
        {vehicle.colors.map((color, index) => (
          <button
            class="carousel-dot"
            type="button"
            data-carousel-dot
            aria-label={`Xem màu ${color.name}`}
            aria-current={index === 0 ? "true" : "false"}
          />
        ))}
      </div>
    </div>

    <div class="product-colors" aria-label="Màu sắc minh họa">
      <span class="product-colors-label">Màu sắc</span>
      {vehicle.colors.map((color, index) => (
        <button
          class="color-swatch color-swatch--button"
          type="button"
          data-color-index={index}
          aria-pressed={index === 0 ? "true" : "false"}
          aria-label={`Xem màu ${color.name}`}
        >
          <i style={`background:${color.hex}`}></i>
          {color.name}
        </button>
      ))}
    </div>

    <div class="story-highlights">
      {vehicle.highlights.map((highlight) => (
        <div class="story-highlight">
          <strong>{highlight.title}</strong>
          <span>{highlight.text}</span>
        </div>
      ))}
    </div>
  </div>

  <div
    class="image-lightbox"
    data-image-lightbox
    role="dialog"
    aria-modal="true"
    aria-label={`Xem ảnh ${vehicle.name}`}
    aria-hidden="true"
  >
    <button class="image-lightbox-close" type="button" data-lightbox-close aria-label="Đóng ảnh phóng to">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
    <figure class="image-lightbox-card">
      <img data-lightbox-image alt="" />
      <figcaption class="image-lightbox-caption" data-lightbox-caption></figcaption>
    </figure>
  </div>
</section>
